<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ProjekatAndrejAntanaskovic.Views.WorkTimePage"
    Title="Radno vreme">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Početak rada"
                FontAttributes="Bold"/>

            <TimePicker
                x:Name="StartTimePicker"/>

            <Label
                Text="Kraj rada"
                FontAttributes="Bold"/>

            <TimePicker
                x:Name="EndTimePicker"/>

            <Label
                Text="Interval (minuti)"
                FontAttributes="Bold"/>

            <Entry
                x:Name="IntervalEntry"
                Keyboard="Numeric"/>

            <Button
                Text="Sačuvaj"
                Clicked="Save_Clicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>