<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ProjekatAndrejAntanaskovic.Views.MyReservationsPage"
    Title="Moje rezervacije">

    <CollectionView
        x:Name="ReservationsCollectionView"
        Margin="10">

        <CollectionView.ItemTemplate>

            <DataTemplate>

                <Frame Margin="5"
                       Padding="10">

                    <VerticalStackLayout>

                        <Label
                            Text="{Binding NazivUsluge}"
                            FontAttributes="Bold"
                            FontSize="18"/>

                        <Label
                            Text="{Binding DatumVreme,
                                   StringFormat='{0:dd.MM.yyyy HH:mm}'}"/>

                        <Label
                            Text="{Binding Status}"/>

                    </VerticalStackLayout>

                </Frame>

            </DataTemplate>

        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>